# Copia este archivo dentro de admin/ con el nombre .htaccess
Options -Indexes

# Aquí se teclea una contraseña: nunca por http. El sitio ya vive en https; esto sólo
# recoge al que llega por un enlace viejo o escribe la dirección sin la s.
#
# Y la página de error, que hay que repetir aquí. Encender RewriteEngine en una carpeta hace
# que mod_rewrite DEJE de heredar las reglas de la de arriba: por eso /admin/loquesea devolvía
# el «404 Not Found» pelado de Apache, en Times New Roman, mientras el resto del sitio
# enseñaba la página de la carta. Se repite la regla en vez de heredarla con
# RewriteOptions InheritDownBefore, que también valdría: heredar aquí metería las reglas de
# arriba en la única carpeta del sitio que pide contraseña, y esta carpeta se toca lo justo.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /tinge_of_turmeric/menu2/admin/
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Sólo lo que NO existe, igual que arriba. index.php, las fotos y las copias no se tocan.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /tinge_of_turmeric/menu2/404.php [L]
</IfModule>

# El .htaccess de la carpeta de arriba pone Referrer-Policy con «always set», y eso PISA la
# que index.php manda por PHP. Allí la política es strict-origin-when-cross-origin, que está
# bien para una carta pública: deja pasar el origen al ir a las reseñas de Google.
#
# Aquí no. Esta carpeta es la que lleva la contraseña en la URL de la pantalla de acceso y
# los nombres de archivo de las copias: al salir a cualquier sitio no se manda nada. Se
# reafirma aquí para ganarle a la regla heredada.
#
# X-Powered-By NO se quita desde aquí: se probó y no funciona, porque PHP la añade después de
# mod_headers. Se quita con header_remove() en config.php, que sí llega a tiempo.
<IfModule mod_headers.c>
  Header always set Referrer-Policy "no-referrer"
</IfModule>

# platos.json, los temporales, el contador de intentos y el registro de accesos no se
# sirven: sólo los lee PHP desde dentro.
<FilesMatch "\.(json|tmp|log|log\.1|txt)$">
  Require all denied
</FilesMatch>

# clave.php y superclave.php guardan los hashes de las contraseñas. Al ser PHP no se
# serviría su contenido aunque se pidiera, pero se deniega igual: dos cierres valen más
# que uno.
<FilesMatch "^(clave|superclave|config|cliente)\.php$">
  Require all denied
</FilesMatch>

# fuentes.html lo lee el PHP del disco, no se sirve por HTTP. tokens.css sí: lo pide el
# navegador con un <link>, así que ese se queda accesible.
<FilesMatch "^fuentes\.html$">
  Require all denied
</FilesMatch>
