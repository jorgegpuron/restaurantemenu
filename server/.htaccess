# Raíz de la carta (menu2/). Subir junto a index.html.
#
# Reproduce lo que el servidor ya sirve en producción (documentado en SPEC.md, «La carta
# vieja en un movil que ya la tenia»): hasta ahora ese .htaccess vivía sólo en el hosting y
# una migración lo habría perdido en silencio — sin gzip son 650 KB de HTML por visita.
Options -Indexes

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# La página de error de la carta. Cubre esta carpeta y todo lo que cuelga de ella.
#
# DOS MECANISMOS, y el orden importa.
#
# El normal es ErrorDocument. Se deja puesto porque es lo correcto y porque en cualquier
# servidor sensato basta con él. PERO ESTE HOSTING LO IGNORA: comprobado a propósito,
# poniéndole una cadena literal y desplegando — el servidor siguió devolviendo su «404 Not
# Found» de trece bytes. No da error ni aviso: lo acepta y no lo aplica.
#
# Así que el que hace el trabajo es el de abajo, con mod_rewrite: cualquier dirección que no
# corresponda a un fichero ni a una carpeta de verdad va a 404.php, que pone el código 404 a
# mano y escribe la página.
#
# Por qué .php y no .html: una regla de reescritura sirve el fichero con código 200. Eso es un
# «soft 404», y es peor que no tener página de error: le dice a Google que la dirección
# inventada existe y merece indexarse. Con PHP la respuesta lleva el 404 de verdad.
#
# Fuera de esta carpeta no llega: socialcard.es y las carpetas de los otros restaurantes tienen
# su propio .htaccess, que no sale de este proyecto.
ErrorDocument 404 /tinge_of_turmeric/menu2/404.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /tinge_of_turmeric/menu2/
  # Sólo lo que NO existe. Un fichero real —la carta, el juego, una foto, el panel— no se toca,
  # y una carpeta real tampoco: sin estas dos condiciones esto se comería el sitio entero.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . 404.php [L]
</IfModule>

<IfModule mod_headers.c>
  # HSTS. El panel ya redirige de http a https, pero ESA PRIMERA petición viaja en claro y
  # con ella la contraseña si alguien la envía por http. Esto le dice al navegador que no
  # vuelva a intentarlo en claro durante un año.
  #
  # OJO, tres cosas que no se ven mirando este archivo:
  #
  #   1. HSTS es del HOST ENTERO, no de esta carpeta. Servida desde aquí, la política cubre
  #      todo socialcard.es: también /reginacafe/ y /dedos_las_americas/. Comprobado antes de
  #      ponerla: los dos responden 200 por https, así que no deja nada inaccesible.
  #
  #   2. Sólo la recibe quien pase por esta carta. Quien entre por socialcard.es y no baje a
  #      menu2/ no queda protegido. Para cubrir el dominio de verdad, esta misma línea tiene
  #      que ir en el .htaccess de la raíz del dominio — que está fuera de este proyecto y no
  #      se toca desde aquí.
  #
  #   3. SIN includeSubDomains a propósito. Hoy www, mail, cpanel y webdisk sirven https, así
  #      que cabría; pero es irreversible durante el max-age y dejaría inaccesible cualquier
  #      subdominio futuro que naciera sin certificado. El riesgo no compensa lo que añade.
  #      Sin preload por lo mismo: eso se quita pidiéndolo a los navegadores, y tarda meses.
  Header always set Strict-Transport-Security "max-age=31536000"

  # El navegador respeta el Content-Type declarado y no adivina por el contenido.
  Header always set X-Content-Type-Options "nosniff"

  # Al salir a otro dominio —el WhatsApp del restaurante, las reseñas de Google— sólo viaja
  # el origen, no la dirección completa. No se usa no-referrer, que es lo que lleva el panel:
  # aquí cortaría la atribución del enlace de reseñas, y esto es una página pública.
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # PHP anuncia su versión exacta en cada respuesta del panel. No es un agujero, pero le
  # ahorra el trabajo a quien escanee buscando versiones con fallos conocidos.
  Header unset X-Powered-By

  # El HTML se guarda pero se pregunta siempre: si no cambió, un 304 de cientos de bytes;
  # si cambió, se ve al momento. no-store daría la misma frescura pagando 77 KB por visita.
  #
  # Y `s-maxage` para que ese 304 lo dé el BORDE y no el origen. Medido en producción, cinco
  # muestras seguidas: el primer byte de la carta tarda ~1 s y sólo 0,13 s son conexión y TLS
  # — el resto es el origen pensando, y con `cf-cache-status: DYNAMIC` cada comensal lo pagaba
  # entero. Con 60 s de borde el origen se toca una vez por minuto y los demás reciben la
  # carta en ~100 ms. Para un menú que escanean diez móviles en el mismo minuto, eso es el
  # caso normal, no el excepcional.
  #
  # Y no retrasa NADA de lo que se cambia desde el panel: agotados, etiquetas, precios nuevos
  # y ofertas viajan en `estado.json`, que es `no-store` y se pide en cada carga (comprobado:
  # el HTML trae siete referencias a él). El HTML sólo cambia al compilar, y de eso avisa
  # `version.json`, que también es `no-store`. Así que el peor caso de estos 60 s es ver el
  # HTML de la compilación anterior durante un minuto después de un despliegue.
  #
  # El navegador no cambia: `max-age=0, must-revalidate` es la misma frescura de siempre.
  #
  # ESTA CABECERA POR SI SOLA NO BASTA, y la regla que la completa YA ESTA PUESTA (13 sep 2026).
  # Cloudflare solo considera cacheable una lista fija de extensiones estaticas y el HTML no esta
  # en ella: con `s-maxage` puesto y sin regla, `cf-cache-status` decia DYNAMIC en todas las
  # medidas —en la misma tanda, /assets/logo.svg daba HIT y / daba DYNAMIC—. La regla la creo el
  # propietario en Caching > Cache Rules, se llama «cache del HTML de Tinge», va la ultima y dice:
  #
  #   starts_with(http.request.uri.path, "/tinge_of_turmeric/menu2/")
  #     and not http.request.uri.path contains "/admin/"
  #     and not http.request.uri.path contains "estado.json"
  #     and not http.request.uri.path contains "record.json"
  #   => Elegible para cache, sin Edge TTL ni Browser TTL propios
  #
  # Sin Edge TTL propio a proposito: asi el TTL lo manda ESTA linea y no vive en dos sitios. Y las
  # tres exclusiones van dentro de la expresion aunque exista otra regla anterior que omite cache
  # para /admin/: si alguien reordena las reglas, el panel y los datos vivos siguen sin cachearse.
  #
  # Medido al terminar: el primer byte de la carta pasa de 0,99-1,08 s a 0,127-0,153 s y
  # `cf-cache-status` da HIT con su `Age`. El panel sigue DYNAMIC con `no-store`, y `estado.json`
  # tambien. Si alguien borra esa regla, esto vuelve solo a DYNAMIC sin avisar de nada: el sintoma
  # es el segundo entero de espera, y se comprueba con `curl -sI` mirando `cf-cache-status`.
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, s-maxage=60, must-revalidate"
  </FilesMatch>

  # estado.json, pedido ANTES de que termine de bajar el HTML.
  #
  # La foto de portada es el elemento más grande de la primera pantalla —lo que Google mide como
  # LCP— y se pedía al final de una fila de tres: primero el documento entero, luego estado.json
  # para saber qué foto es, y sólo entonces la foto. Medido por PageSpeed en móvil: 1.710 ms de
  # espera antes de empezar siquiera a pedir la imagen.
  #
  # Esta cabecera viaja con la PRIMERA respuesta, antes que una sola línea del HTML, así que el
  # navegador empieza a bajar estado.json mientras todavía está recibiendo el documento. Los dos
  # primeros viajes dejan de ir en fila y pasan a solaparse.
  #
  # Va en el servidor y no en una etiqueta del HTML a propósito: dentro del documento no se
  # descubre antes que el documento, que es justo el problema que resuelve.
  #
  # OJO: el fetch del runtime tiene que pedir esta MISMA dirección, sin ?t= ni nada detrás, o el
  # navegador se baja el fichero dos veces. La frescura la garantiza el no-store de más abajo.
  #
  # SÓLO en la carta. El juego y la página de error también son .html y no leen el estado: ahí
  # sería una petición que nadie recoge, y el navegador avisa por consola de que se ha
  # precargado algo sin usar.
  #
  # Con <Files> y no con <If>: <If> necesita Apache 2.4 con mod_authz_core, y en un hosting
  # compartido donde falte no da un aviso, da un error 500 y se lleva la carta por delante.
  # <Files> existe desde siempre. Y cubre tanto /menu2/ como /menu2/index.html: Apache resuelve
  # primero el índice del directorio y luego mira el nombre del fichero.
  <Files "index.html">
    Header set Link "<estado.json>; rel=preload; as=fetch; crossorigin"
  </Files>
  # Lo que cambia durante el servicio no se guarda nunca. version.json es además la marca
  # que decide la recarga única por sesión: cachearlo rompería justo lo que resuelve.
  <FilesMatch "^(estado|version|record)\.json$">
    Header set Cache-Control "no-store"
  </FilesMatch>
  # Las fotos del panel llevan nombre aleatorio: una foto nueva es una URL nueva. Un mes.
  <FilesMatch "\.(png|jpe?g|webp|svg|woff2?)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

# El estado de EJEMPLO no se sirve. Sube con la carta a propósito —es la semilla que se
# renombra a mano la primera vez que se instala en un servidor, y por eso no se puede quitar
# del build— pero nadie tiene por qué poder leerlo desde fuera: es un fichero de instalación
# expuesto en una carta pública. Sigue estando en el disco para quien entre por FTP.
<Files "estado-EJEMPLO.json">
  Require all denied
</Files>
